# Copy this file to .env and update the values below

# Application Settings
APP_NAME=StudyNest
APP_KEY=
APP_ENV=development
# Set SESSION_DRIVER=database in Render after creating the sessions table
# with database/repair_teacher_application_schema.sql.
# Local development defaults to PHP file sessions.
# SESSION_DRIVER=database

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studynest
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
GOOGLE_CLIENT_ID=38405369536-v4gprbtfbn3jqee20g3tim32akiecgf9.apps.googleusercontent.com

# GroqCloud AI quiz generation (keep the API key on the backend only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Brevo SMTP (use the SMTP login and SMTP key from Brevo, not your account password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_TIMEOUT=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StudyNest
STUDYNEST_APP_URL=https://studynest-r85g.onrender.com