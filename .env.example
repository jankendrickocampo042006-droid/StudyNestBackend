# Copy this file to .env and update the values below

# Application Settings
APP_NAME=StudyNest
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studynest
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StudyNest